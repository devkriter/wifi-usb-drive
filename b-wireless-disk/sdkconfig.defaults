# esp-iot-solution usb_msc_wireless_disk on the Waveshare ESP32-S3-LCD-1.47 (Milestone B).
# Based on the upstream sdkconfig.ci.esp32s3r8 (octal-PSRAM tuned buffers), adapted to this board.
# WiFi credentials live in sdkconfig.secrets (gitignored); build with
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.secrets" set-target esp32s3
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_example.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- board: generic S3, microSD over SDMMC, 1-bit (D1/D2 jumpers R11/R18 are unpopulated) ----
CONFIG_ESP32_S3_GENERIC=y
CONFIG_USE_EXTERNAL_SDCARD=y
CONFIG_SDCARD_INTFC_SDIO=y
CONFIG_SDCARD_SDIO_DATA_WIDTH_1=y
CONFIG_SDCARD_SDIO_CLK_PIN=14
CONFIG_SDCARD_SDIO_CMD_PIN=15
CONFIG_SDCARD_SDIO_D0_PIN=16
# never format the user's card on a mount failure
# CONFIG_FORMAT_IF_MOUNT_FAILED is not set

# ---- octal PSRAM ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# ---- upstream throughput tuning (r8 profile) ----
CONFIG_FILE_WRITE_BUFFER_COUNT=10
CONFIG_FILE_WRITE_BUFFER_SIZE=128
CONFIG_FILE_DMA_BUFFER_SIZE=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=85
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_DYNAMIC=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# ---- WiFi: station on the home network (SSID/password from sdkconfig.secrets); softAP off ----
CONFIG_ESP_WIFI_SOFTAP_SSID=""

# ---- console: UART0 primary (TinyUSB owns the USB port); USB-JTAG mirror until TinyUSB starts ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ---- flashing: the BOOT-hold helper leaves the ROM in download mode, so no pre-flash reset ----
CONFIG_ESPTOOLPY_BEFORE_NORESET=y
