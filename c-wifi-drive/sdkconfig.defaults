# WiFi USB drive firmware (Milestone C) on the Waveshare ESP32-S3-LCD-1.47.
# WiFi credentials live in sdkconfig.secrets (gitignored). First configure with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.secrets" set-target esp32s3
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- octal PSRAM (ESP32-S3R8) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# ---- USB: mass storage + a CDC port that mirrors the log ----
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sdcard"
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Waveshare ESP32-S3"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="WiFi Drive"
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
CONFIG_TINYUSB_DESC_MSC_STRING="WiFi Drive SD card"
CONFIG_TINYUSB_DESC_CDC_STRING="WiFi Drive log"

# ---- FAT ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_DYNAMIC=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y

# ---- WiFi / LWIP throughput profile (from Espressif's wireless-disk r8 config) ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=85
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# ---- HTTP server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# ---- file server buffers (r8 profile) ----
CONFIG_FILE_WRITE_BUFFER_COUNT=10
CONFIG_FILE_WRITE_BUFFER_SIZE=128
CONFIG_FILE_DMA_BUFFER_SIZE=32

# ---- WiFi defaults: station on the home network (see sdkconfig.secrets); softAP off ----
CONFIG_ESP_WIFI_SOFTAP_SSID=""

# ---- console: UART0 (header TXD/RXD); the firmware mirrors logs to the USB CDC port ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- flashing: the BOOT helper leaves the ROM in download mode, so no pre-flash reset ----
CONFIG_ESPTOOLPY_BEFORE_NORESET=y

# file server on
CONFIG_WIFI_HTTP_ACCESS=y

# ---- LVGL (status screen): 16-bit colour, fonts for the big status word and details ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# ---- OTA rollback: a new image must mark itself valid (health_task) or the bootloader reverts ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# LVGL memory: system allocator instead of a 64 KB static pool in internal RAM
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
# smaller HTTP read buffer (internal DMA RAM is the scarce resource)
CONFIG_FILE_READ_BUFFER_SIZE=16

# free space: recount the FAT instead of trusting the FSInfo hint (Windows leaves it stale)
CONFIG_FATFS_DONT_TRUST_FREE_CLUSTER_CNT=1

# setup access point when the home network is unreachable
CONFIG_WD_FALLBACK_AP_ENABLE=y
CONFIG_WD_FALLBACK_AP_PASSWORD="wifidrive"

# QR code widget for the setup network
CONFIG_LV_USE_QRCODE=y
